APP_ENV="development"
APP_PORT=8080

# Full URL of the frontend reset-password page, the emailed link points here.
URL_FORGOT_PASSWORD=http://localhost:3000/reset-password
# Base URL of this API, used to build the email verification link.
URL_APP=http://localhost:8080

DATABASE_PORT=5432
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=lokal
DATABASE_NAME=sayur-user-service
DATABASE_MAX_OPEN_CONNECTIONS=10
DATABASE_MAX_OPEN_CONNECTIONS=20

# Redis. The compose file publishes the container's 6379 on host port 6380,
# so the host value is 6380 while the container keeps the default.
REDIS_HOST=localhost
REDIS_PORT=6380

JWT_SECRET_KEY="secret"
JWT_ISSUER="secret "

# Supabase Storage. URL must be the storage endpoint
# (https://<project-ref>.supabase.co/storage/v1), not the /rest/v1/ one.
# The key is a server-side secret key and must never be shipped to a client.
SUPABASE_STORAGE_URL=""
SUPABASE_STORAGE_KEY=""
SUPABASE_STORAGE_BUCKET=""
